--!strict
-- L4 W2 (docs/prompts/l4-w2-contract.md §2.1, §2.2; rulings L4W2-1 to L4W2-6): whether a level is
-- built dressed. The dress file (Config/LevelDress/<layout>.json, generated by tools/levels/
-- forest.py) says which meshes draw the level, which of its grey Parts they draw over (those are
-- hidden: no look, their collision and query kept), which invisible walls the dressed level adds
-- and which looks it lays over Expeditions.json's. The server decides "dressed" all or nothing,
-- before it hides anything (L4W2-2): one thing wrong and the level is today's grey level exactly,
-- with one warn naming the first thing found. A dressed level whose meshes then fail on a client
-- is that client's to undo (LevelScenery shows every hidden Part again): no collision is ever left
-- invisible because a mesh is missing.
--
-- Pure: tables, strings and numbers; no Instance, no service, no clock, so tools/crowd_harness
-- loads it as it stands. LevelService gathers what is on the server (the uploaded hash, the
-- templates found, the groups' state) and only executes the answer.
--
-- The L4 W2 fix round (K7): the whole decision is here and tested. Decide is the one call a build
-- makes (the Z lever's hash, the names a found shortcut left out, which templates hold a mesh, and
-- Accept behind a pcall: a dress that throws is a refusal, so the level is grey with one warn,
-- never a Build that throws). Its answer carries Workspace.Level's word (`word`: the layout and
-- the plan hash together), so "dressed with no hash" cannot be written. Lay turns the answer, or
-- no answer, into what is built: the grey level is `pieces` as they are, nothing hidden, the base
-- looks and no word.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Types"))
local LevelGeometry = require(script.Parent:WaitForChild("LevelGeometry"))

type Looks = { [string]: Types.LevelLook }

-- What Workspace.Level carries while the level is dressed: `Dress` = layout, `DressHash` =
-- planHash (the uploaded hash Accept held the file to). One table, so neither is set alone.
export type Word = { layout: string, planHash: string }

-- What a dressed level adds to the grey one. `walls`: one Piece per dress barrier, in the file's
-- order, role WALL_ROLE, no camp, no look, collide true. `hidden`: the names of the pieces a mesh
-- draws over (hide.blocks' blocks, hide.camps' roles of each camp). `looks`: the dress's own looks,
-- to be laid over Expeditions.json's (Overlay) for the level's Parts. `word`: what the clients are
-- told once every Part stands.
export type Accepted = {
	walls: { LevelGeometry.Piece },
	hidden: { [string]: boolean },
	looks: Looks,
	word: Word,
}

-- What a build hands Decide, gathered on the server and judged here. `templates`: each Model under
-- ReplicatedStorage.Assets.Levels.<layoutName> by name, with the MeshId of every MeshPart it holds
-- (Present says which hold a mesh). `found`: the shortcut ids the leader has found (LeftOut turns
-- them into the block names left out of the build). `failLever`: the Z lever, spent by this build.
export type Ask = {
	dress: Types.LevelDress?,
	uploadedHash: string?,
	failLever: boolean,
	templates: { [string]: { string } },
	layout: Types.LevelLayout,
	pieces: { LevelGeometry.Piece },
	found: { [string]: boolean }?,
	groupsOk: boolean,
	maxParts: number,
	layoutName: string,
}

-- What a build constructs (Lay). `pieces`: the layout's, then the dress's walls. `hidden`: the
-- pieces a mesh draws over (empty when grey). `looks`: the looks the Parts take. `word`: nil when
-- grey.
export type Laid = {
	pieces: { LevelGeometry.Piece },
	hidden: { [string]: boolean },
	looks: Looks?,
	word: Word?,
}

-- Structural: the role a dress wall's piece has (LevelService builds it as an invisible wall that
-- holds from the build), and the frame a dress must be written in (world studs, the level's own).
local WALL_ROLE = "treeline"
local LEVEL_FRAME = "level"
-- What the Z lever hands Accept as the uploaded hash: never a real one (a plan hash is hex).
local FAILED_HASH = "(the dressFail lever)"
-- A MeshId that names no asset: empty, or the id gen_templates.py writes for one never uploaded.
local NO_MESH: { [string]: boolean } = {
	[""] = true,
	["rbxassetid://0"] = true,
}
-- L4W2-5: the camp roles a dress may draw over (LevelGeometry's floor, fence, obstacle, fire
-- marker and tent marker). A gate, a checkpoint or a camp's own wall is shown or recoloured by
-- the run itself (LevelService.SetCamp), so it is never hidden.
local HIDEABLE: { [string]: boolean } = {
	floor = true,
	fence = true,
	obstacle = true,
	fire = true,
	tent = true,
}

local LevelDress = {}

LevelDress.WALL_ROLE = WALL_ROLE
LevelDress.FAILED_HASH = FAILED_HASH

-- NaN fails the first comparison.
local function finite(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Why a `props` entry cannot be placed as LevelScenery places it (nil = it can): a template's
-- name, a finite place and turn, a scale above 0, and `with` absent or a Part's name.
local function propProblem(entry: any): string?
	if type(entry) ~= "table" then
		return "is not a table"
	end
	if type(entry.piece) ~= "string" or entry.piece == "" then
		return "names no piece"
	end
	if not (finite(entry.x) and finite(entry.y) and finite(entry.z) and finite(entry.yaw)) then
		return "has a place or a turn that is not a number"
	end
	if not finite(entry.scale) or entry.scale <= 0 then
		return "has a scale that is not above 0"
	end
	local with = entry.with
	if with ~= nil and (type(with) ~= "string" or with == "") then
		return "stands with something that is not a Part's name"
	end
	return nil
end

-- Why an `effects` entry cannot be drawn (nil = it can): a kind and a finite place.
local function effectProblem(entry: any): string?
	if type(entry) ~= "table" then
		return "is not a table"
	end
	if type(entry.kind) ~= "string" or entry.kind == "" then
		return "has no kind"
	end
	if not (finite(entry.x) and finite(entry.y) and finite(entry.z)) then
		return "has a place that is not a number"
	end
	return nil
end

local function shown(value: any): string
	return if type(value) == "string" then `"{value}"` else tostring(value)
end

-- A barrier entry as a Box, or nil when a number is not finite or a size is not above 0.
local function wallBox(entry: any): LevelGeometry.Box?
	if type(entry) ~= "table" then
		return nil
	end
	local x, y, z, sx, sy, sz = entry.x, entry.y, entry.z, entry.sx, entry.sy, entry.sz
	if
		not (finite(x) and finite(y) and finite(z) and finite(sx) and finite(sy) and finite(sz))
		or sx <= 0
		or sy <= 0
		or sz <= 0
	then
		return nil
	end
	return { x = x, y = y, z = z, sx = sx, sy = sy, sz = sz }
end

-- The names of the layout's blocks a found shortcut leaves out of the build (L2-36: a block whose
-- `opens` names a shortcut in `open`): Accept's `open`. Empty for no shortcut found.
function LevelDress.LeftOut(
	layout: Types.LevelLayout,
	open: { [string]: boolean }?
): { [string]: boolean }
	local left: { [string]: boolean } = {}
	if open == nil then
		return left
	end
	local blocks: any = layout.blocks
	if type(blocks) ~= "table" then
		return left
	end
	for _, block: any in blocks do
		if
			type(block) == "table"
			and type(block.name) == "string"
			and block.opens ~= nil
			and open[block.opens] == true
		then
			left[block.name] = true
		end
	end
	return left
end

-- Expeditions.json's looks with the dress's laid over them, a new table (neither is changed). A
-- look the dress names wins over the one of that name; every other stays.
function LevelDress.Overlay(
	base: { [string]: Types.LevelLook }?,
	over: { [string]: Types.LevelLook }?
): { [string]: Types.LevelLook }
	local looks: { [string]: Types.LevelLook } = if base ~= nil then table.clone(base) else {}
	if over ~= nil then
		for name, look in over do
			looks[name] = look
		end
	end
	return looks
end

-- The dress of `layout` (the level's layout name), if it can be used as the server will build
-- the level, else nil and the first reason found, in this order: there is no dress; its `layout`
-- or its `frame` differ; its planHash is not `uploadedHash` (Assets.json levels.<layout>.planHash,
-- the Valley's rule: the meshes uploaded were baked from another plan, or none were); a mesh has
-- no template (`haveMeshes`: the names of the Models under ReplicatedStorage.Assets.Levels.
-- <layout>); a hide.blocks name matches no `block` piece of `pieces` (LevelGeometry.Pieces' answer)
-- and is not one `open` left out (LevelDress.LeftOut); a hide.camps entry names a camp no piece
-- has, a role other than HIDEABLE's, or a role no piece of that camp has; `groupsOk` is false
-- (BarrierGroups refused its groups: a wall would stop the camera and every shot); a barrier is
-- unsound (no name, a number that is not finite, a size not above 0) or its name is already a
-- piece's or an earlier barrier's; or the pieces and the walls together are more than `maxParts`
-- Parts. `layout` (the last argument, beside the contract's seven) is the name the level asked
-- for: a dress file names its own layout, and one copied under another name is refused.
function LevelDress.Accept(
	dress: Types.LevelDress?,
	uploadedHash: string?,
	haveMeshes: { [string]: boolean },
	pieces: { LevelGeometry.Piece },
	open: { [string]: boolean }?,
	groupsOk: boolean,
	maxParts: number,
	layout: string
): (Accepted?, string?)
	if dress == nil then
		return nil, `there is no dress file (Config/LevelDress/{layout})`
	end
	local file: any = dress
	if file.layout ~= layout then
		return nil, `the dress is for the layout {shown(file.layout)}, not "{layout}"`
	end
	if file.frame ~= LEVEL_FRAME then
		return nil, `the dress's frame is {shown(file.frame)}, not "{LEVEL_FRAME}"`
	end
	if uploadedHash == nil then
		return nil, `no meshes are uploaded for it (Assets.json levels.{layout} has no planHash)`
	end
	if type(file.planHash) ~= "string" or file.planHash ~= uploadedHash then
		return nil,
			`its plan hash {shown(file.planHash)} is not the uploaded meshes' "{uploadedHash}"`
	end
	local meshes: any = file.meshes
	if type(meshes) ~= "table" then
		return nil, "its meshes are not a list"
	end
	for index, mesh: any in meshes do
		local name = if type(mesh) == "table" then mesh.name else nil
		if type(name) ~= "string" then
			return nil, `mesh {index} has no name`
		end
		if haveMeshes[name] ~= true then
			return nil, `the mesh "{name}" has no template with a mesh`
		end
	end
	-- K7: what the client places and draws is held here too, so a file it could not read is grey
	-- on the server and on every client alike.
	local props: any = file.props
	if type(props) ~= "table" then
		return nil, "its props are not a list"
	end
	for index, entry: any in props do
		local problem = propProblem(entry)
		if problem ~= nil then
			return nil, `prop {index} {problem}`
		end
	end
	local effects: any = file.effects
	if type(effects) ~= "table" then
		return nil, "its effects are not a list"
	end
	for index, entry: any in effects do
		local problem = effectProblem(entry)
		if problem ~= nil then
			return nil, `effect {index} {problem}`
		end
	end

	-- What the level is built of: each block piece by name, each camp's roles.
	local named: { [string]: boolean } = {}
	local blocks: { [string]: boolean } = {}
	local roles: { [string]: { [string]: boolean } } = {}
	for _, piece in pieces do
		named[piece.name] = true
		if piece.role == "block" then
			blocks[piece.name] = true
		end
		local camp = piece.camp
		if camp ~= nil then
			local own = roles[camp]
			if own == nil then
				own = {}
				roles[camp] = own
			end
			(own :: { [string]: boolean })[piece.role] = true
		end
	end

	local hide: any = file.hide
	if type(hide) ~= "table" then
		return nil, "its hide block is not a table"
	end
	local hidden: { [string]: boolean } = {}
	local hideBlocks: any = hide.blocks
	if type(hideBlocks) ~= "table" then
		return nil, "its hide.blocks is not a list"
	end
	for _, name: any in hideBlocks do
		if type(name) ~= "string" then
			return nil, `hide.blocks holds {shown(name)}, not a block's name`
		end
		if blocks[name] then
			hidden[name] = true
		elseif open == nil or open[name] ~= true then
			return nil, `hide.blocks names "{name}", which no block of the level is`
		end
	end
	local hideCamps: any = hide.camps
	if type(hideCamps) ~= "table" then
		return nil, "its hide.camps is not a table"
	end
	-- In camp order, so the first reason is the same every time.
	local campIds: { string } = {}
	for id in hideCamps do
		if type(id) ~= "string" then
			return nil, `hide.camps holds {shown(id)}, not a camp id`
		end
		table.insert(campIds, id)
	end
	table.sort(campIds)
	local hiddenRoles: { [string]: { [string]: boolean } } = {}
	for _, id in campIds do
		local own = roles[id]
		if own == nil then
			return nil, `hide.camps names the camp "{id}", which the level has no piece of`
		end
		local list: any = hideCamps[id]
		if type(list) ~= "table" then
			return nil, `hide.camps.{id} is not a list of roles`
		end
		local wanted: { [string]: boolean } = {}
		for _, role: any in list do
			if type(role) ~= "string" or HIDEABLE[role] ~= true then
				return nil,
					`hide.camps.{id} names the role {shown(role)}, which a dress may not hide`
			end
			if own[role] ~= true then
				return nil,
					`hide.camps.{id} names the role "{role}", which no piece of that camp has`
			end
			wanted[role] = true
		end
		hiddenRoles[id] = wanted
	end
	for _, piece in pieces do
		local camp = piece.camp
		local wanted = if camp ~= nil then hiddenRoles[camp] else nil
		if wanted ~= nil and wanted[piece.role] then
			hidden[piece.name] = true
		end
	end

	if not groupsOk then
		return nil,
			"the invisible walls' collision groups are not there (a wall would stop rays and the camera)"
	end
	local barriers: any = file.barriers
	if type(barriers) ~= "table" then
		return nil, "its barriers are not a list"
	end
	local walls: { LevelGeometry.Piece } = {}
	for index, entry: any in barriers do
		local name = if type(entry) == "table" then entry.name else nil
		local box = wallBox(entry)
		if type(name) ~= "string" or name == "" or box == nil then
			return nil,
				`barrier {index} ({shown(name)}) has no name, a position that is not a number or a size that is not positive`
		end
		if named[name] then
			return nil, `barrier {index}'s name "{name}" is already a Part's`
		end
		named[name] = true
		table.insert(walls, {
			name = name,
			role = WALL_ROLE,
			box = box,
			collide = true,
		})
	end
	local count = #pieces + #walls
	if count > maxParts then
		return nil, `{count} Parts with the walls, over levels.maxParts ({maxParts})`
	end

	local looks: any = file.looks
	return {
		walls = walls,
		hidden = hidden,
		looks = if type(looks) == "table" then looks else {},
		word = { layout = layout, planHash = uploadedHash },
	},
		nil
end

-- The templates a mesh may be drawn from: the names whose Model holds at least one MeshPart with a
-- MeshId that names an asset. A Model left with no mesh (a broken harvest, an id never uploaded)
-- is no template, so its pieces are never hidden with nothing drawn over them.
function LevelDress.Present(templates: { [string]: { string } }): { [string]: boolean }
	local present: { [string]: boolean } = {}
	for name, meshIds in templates do
		for _, meshId: any in meshIds do
			if type(meshId) == "string" and NO_MESH[meshId] ~= true then
				present[name] = true
				break
			end
		end
	end
	return present
end

-- The build's one decision (K7): the dress Accept takes, judged on what the server holds, or nil
-- and why. The Z lever hands Accept FAILED_HASH for the uploaded hash, so its grey level comes
-- through the real refusal. Behind a pcall: a file Accept throws on is refused like any other,
-- naming the error.
function LevelDress.Decide(ask: Ask): (Accepted?, string?)
	local ok, accepted, reason = pcall(function(): (Accepted?, string?)
		return LevelDress.Accept(
			ask.dress,
			if ask.failLever then FAILED_HASH else ask.uploadedHash,
			LevelDress.Present(ask.templates),
			ask.pieces,
			LevelDress.LeftOut(ask.layout, ask.found),
			ask.groupsOk,
			ask.maxParts,
			ask.layoutName
		)
	end)
	if not ok then
		return nil, `the dress could not be read ({tostring(accepted)})`
	end
	if accepted == nil then
		return nil, reason or "the dress was refused"
	end
	return accepted, nil
end

-- What a build constructs from Decide's answer. Grey (`accepted` nil) is the level as it was
-- before dressing existed: `pieces` itself, nothing hidden, `base`'s looks and no word. Dressed:
-- a new list of `pieces` then the walls (`pieces` is never changed), the pieces a mesh draws over,
-- `base` with the dress's looks laid over it, and the word.
function LevelDress.Lay(pieces: { LevelGeometry.Piece }, base: Looks?, accepted: Accepted?): Laid
	if accepted == nil then
		return { pieces = pieces, hidden = {}, looks = base, word = nil }
	end
	local built = table.clone(pieces)
	table.move(accepted.walls, 1, #accepted.walls, #built + 1, built)
	return {
		pieces = built,
		hidden = accepted.hidden,
		looks = LevelDress.Overlay(base, accepted.looks),
		word = accepted.word,
	}
end

return LevelDress
