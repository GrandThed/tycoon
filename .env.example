# Roblox Open Cloud credentials for tools/upload_audio.py
#
# THIS FILE IS GITIGNORED AND MUST STAY THAT WAY. Never paste this key into chat,
# a commit, a doc, or an issue. Revoke it at create.roblox.com/dashboard/credentials
# once the audio upload is done.
#
# Create the key at: create.roblox.com/dashboard/credentials -> API Keys -> Create
#   Permissions : add the "Assets" API System, scope it to the creator that owns
#                 the place, and grant write (asset:write). Nothing else.
#   IP allowlist: your own IP, or 0.0.0.0/0 if you cannot pin it.
#   Expiry      : the shortest option offered.

ROBLOX_API_KEY=

# Who the uploaded audio is created under. Must be the same creator that owns the
# published place, or the experience cannot use the sounds.
#   user  -> your numeric user id  (profile URL: roblox.com/users/<THIS>/profile)
#   group -> your numeric group id (group URL:  roblox.com/groups/<THIS>/...)
ROBLOX_CREATOR_TYPE=user
ROBLOX_CREATOR_ID=

# Folder holding the audio files to upload (.mp3 or .ogg), relative to the repo root.
AUDIO_SOURCE_DIR=assets/audio
