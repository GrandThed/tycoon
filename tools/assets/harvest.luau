-- the footprint; docs/ASSET_RESEARCH.md section 3).
local ASSETS = {
	{ kind = "prop", era = "Boomtown", model = "Bend", stage = 0, id = 85078226894254 },
	{ kind = "prop", era = "Boomtown", model = "HouseA", stage = 0, id = 74665188214317 },
