{
	"version": "2.0.0",
	"options": {
		"cwd": "${workspaceFolder}",
		"env": {
			"PATH": "${env:USERPROFILE}\\.rokit\\bin;${env:PATH}"
		}
	},
	"tasks": [
		{
			"label": "Build hub",
			"type": "shell",
			"command": "rojo build -o build/test.rbxl",
			"problemMatcher": []
		},
		{
			"label": "Build combat",
			"type": "shell",
			"command": "rojo build combat.project.json -o build/combat.rbxl",
			"problemMatcher": []
		},
		{
			"label": "Build proving",
			"type": "shell",
			"command": "py tools/proving_project.py; rojo build .proving.project.json -o build/proving.rbxl",
			"problemMatcher": []
		},
		{
			"label": "Build all",
			"dependsOn": [
				"Build hub",
				"Build combat",
				"Build proving"
			],
			"dependsOrder": "sequence",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
