{
	"name": "EraCityTycoonExpeditions",
	"globIgnorePaths": ["templates/_props", "templates/_paths", "templates/_enemies", "templates/_world"],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"Shared": {
				"$path": "src/shared"
			},
			"Packages": {
				"$path": "Packages"
			},
			"Assets": {
				"$className": "Folder",
				"Props": {
					"$className": "Folder",
					"$path": { "optional": "templates/_props" }
				}
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"Server": {
				"$className": "Folder",
				"Main": {
					"$path": "src/combat/server/Main.server.luau"
				},
				"Services": {
					"$path": "src/server/Services"
				},
				"Combat": {
					"$path": "src/combat/server/Services"
				}
			},
			"ServerPackages": {
				"$path": "ServerPackages"
			}
		},
		"ServerStorage": {
			"$className": "ServerStorage",
			"$ignoreUnknownInstances": true,
			"Enemies": {
				"$className": "Folder",
				"$path": { "optional": "templates/_enemies" }
			}
		},
		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"StreamingEnabled": false
			},
			"$ignoreUnknownInstances": true
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"$properties": {
				"CameraMaxZoomDistance": 16
			},
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"Client": {
					"$className": "Folder",
					"Main": { "$path": "src/combat/client/Main.client.luau" },
					"UI": {
						"$path": "src/combat/client/UI",
						"Create": { "$path": "src/client/UI/Create.luau" },
						"Motion": { "$path": "src/client/UI/Motion.luau" },
						"Toast": { "$path": "src/client/UI/Toast.luau" },
						"LoadScreen": { "$path": "src/client/UI/LoadScreen.luau" },
						"Theme": { "$path": "src/client/UI/Theme.luau" },
						"MapScreen": { "$path": "src/client/UI/MapScreen.luau" },
						"ArmoryScreen": { "$path": "src/client/UI/ArmoryScreen.luau" },
						"ArmoryStage": { "$path": "src/client/UI/ArmoryStage.luau" },
						"ArmoryTrack": { "$path": "src/client/UI/ArmoryTrack.luau" },
						"ArmoryShelf": { "$path": "src/client/UI/ArmoryShelf.luau" },
						"ArmoryDetail": { "$path": "src/client/UI/ArmoryDetail.luau" },
						"ArmoryAbilityPage": { "$path": "src/client/UI/ArmoryAbilityPage.luau" },
						"ArmoryModel": { "$path": "src/client/UI/ArmoryModel.luau" }
					},
					"Controllers": {
						"$path": "src/combat/client/Controllers",
						"SoundController": { "$path": "src/client/Controllers/SoundController.luau" }
					}
				}
			}
		}
	}
}
